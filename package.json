{
  "name": "gfm-bun-render",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/quirks/index.ts",
    "./vscode": "./src/vscode/index.ts",
    "./compare": "./src/compare/index.ts",
    "./ffi": "./src/ffi/index.ts"
  },
  "imports": {
    "#ffi": {
      "bun": "./src/ffi/bun.ts",
      "node": "./src/ffi/node.ts",
      "default": "./src/ffi/node.ts"
    }
  },
  "scripts": {
    "test": "bun test --timeout 60000",
    "render": "bun src/quirks/cli.ts",
    "test:e2e": "bun test test/e2e.test.ts test/fuzz-regressions.test.ts --timeout 60000",
    "test:node": "node --test test/node-ffi.node.ts",
    "compare": "bun scripts/compare-renderers.ts",
    "fuzz": "bun scripts/fuzz-renderer.ts"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "1.1.2",
    "markdown-it": "14.2.0",
    "markdown-it-source-map": "0.1.1"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24"
  },
  "peerDependencies": {
    "koffi": "^3.3.7",
    "node-tinycc": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "koffi": {
      "optional": true
    },
    "node-tinycc": {
      "optional": true
    }
  },
  "devDependencies": {
    "happy-dom": "21.0.4"
  }
}
